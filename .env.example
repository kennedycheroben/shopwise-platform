# ==============================================================================
# ShopWise Kenya - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your environment-specific credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
APP_NAME="ShopWise Kenya"
APP_ENV=local               # 'local' for development, 'production' for live deployment
APP_DEBUG=true              # true for development error traces, false in production
APP_URL=http://localhost/shopwise-platform/public  # Set your full public URL or leave empty for auto-detection
APP_KEY=                    # 32-character random string or 64-hex key for signing/encryption
APP_TIMEZONE=Africa/Nairobi

# ------------------------------------------------------------------------------
# 2. Database Connection (MySQL / MariaDB via PDO)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopwise_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 Integration (Customer Storefront Sign-In)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Register the exact Redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=           # e.g. YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=       # e.g. GOCSPX-YOUR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=        # Optional override: default is <APP_URL>/auth/google/callback

# ------------------------------------------------------------------------------
# 4. Email / SMTP Configuration (PHPMailer & Background Queue)
# ------------------------------------------------------------------------------
# MAIL_DRIVER options: 'queue_only' (recommended in dev), 'smtp' (live dispatch), or 'mail'
MAIL_DRIVER=queue_only
MAIL_HOST=mail.kennedycheroben.co.ke
MAIL_PORT=465
MAIL_USERNAME=support@kennedycheroben.co.ke
MAIL_PASSWORD=              # Your authenticated SMTP mailbox password
MAIL_ENCRYPTION=ssl         # 'ssl', 'tls', or null
MAIL_FROM_ADDRESS=support@kennedycheroben.co.ke
MAIL_FROM_NAME="ShopWise Kenya"

# ------------------------------------------------------------------------------
# 5. M-Pesa Daraja STK Push Integration
# ------------------------------------------------------------------------------
# MPESA_ENV: 'sandbox' or 'production'. NEVER use production credentials in sandbox.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=         # Daraja Developer Portal App Consumer Key
MPESA_CONSUMER_SECRET=      # Daraja Developer Portal App Consumer Secret
MPESA_SHORTCODE=174379      # Daraja Business Shortcode (174379 for sandbox paybill)
# Safaricom public Daraja sandbox passkey is published in Safaricom documentation:
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline  # 'CustomerPayBillOnline' or 'CustomerBuyGoodsOnline'
# Webhook Callback base URL (must NOT contain "mpesa", "safaricom", or "daraja" in hostname)
MPESA_CALLBACK_BASE_URL=http://localhost/shopwise-platform/public
MPESA_CALLBACK_SECRET=      # Secure random hex string to authenticate incoming callback requests
MPESA_INITIATOR_NAME=testapi

# ------------------------------------------------------------------------------
# 6. Uploads & Rate Limiting (Optional Overrides)
# ------------------------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_MB=5
RATE_LIMIT_STORAGE_DIR=

