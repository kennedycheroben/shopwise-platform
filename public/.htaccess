# ==============================================================================
# ShopWise Kenya - Public Web Root Configuration & Front Controller Rewrites
# ==============================================================================

# Disable Directory Browsing
Options -Indexes

# Protect Hidden Files & Dotfiles
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Browser Caching for Static Assets (Images, Fonts, CSS, JS)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|webp|jpg|jpeg|png|gif|svg|css|js|woff|woff2|ttf)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>


# UTF-8 Encoding Default
AddDefaultCharset UTF-8

# Front Controller Routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Explicitly block access to protected source folders if misrouted
    RewriteRule ^(app|database|cron|scripts|storage|vendor|_template_reference)(\/|$) - [F,L,NC]

    # Allow direct access to admin, assets, uploads
    RewriteRule ^(admin|assets|uploads)(/.*)?$ - [L]

    # Don't rewrite real existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all storefront requests to index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>
